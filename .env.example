# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Random long secret for session cookies
AUTH_SECRET="replace-with-a-long-random-secret"
# Credit Point Tracker database (read-only), used for students' credit points. Matched by boarding number.
CREDIT_POINTS_DATABASE_URL="postgresql://erp_reader:PASSWORD@HOST/DBNAME?sslmode=require"
# Show demo accounts on the login page in production (for client demos). Set to "false" for real use.
NEXT_PUBLIC_SHOW_DEMO_LOGINS="true"
